const rectangle = (x0: number, z0: number, x1: number, z1: number): [PointXZ, PointXZ, PointXZ, PointXZ] =>
  [[x0, z0], [x1, z0], [x1, z1], [x0, z1]];

function installTop(world: CollisionWorld, polygon: readonly PointXZ[], heightAt: (z: number) => number,
  surface: 'stone' | 'stair') {
  const positions: number[] = [];
  for (const face of ShapeUtils.triangulateShape(polygon.map(([x, z]) => new Vector2(x, z)), [])) {
    for (const index of face) {
      const [x, z] = polygon[index]!;
      positions.push(x, heightAt(z), z);
    }
  }
  world.addTriangles(positions, { kind: 1, surface });
}

function installSlope(world: CollisionWorld, [, x0, z0, x1, z1, nearY, farY]: Stair | Roof, surface: 'stone' | 'stair') {
  const tilt = (farY - nearY) / (z1 - z0);
  installTop(world, rectangle(x0, z0, x1, z1), z => nearY + (z - z0) * tilt, surface);
}

function guardSegments(polygon: readonly PointXZ[], open: readonly Opening[]): WallPath[] {
  const edges: WallPath[] = [];
  for (const [index, [x0, z0]] of polygon.entries()) {
    const [x1, z1] = polygon[(index + 1) % polygon.length]!;
    const length = Math.hypot(x1 - x0, z1 - z0);
    const tx = (x1 - x0) / length;
    const tz = (z1 - z0) / length;
    const exclusions: [from: number, to: number][] = [];
    for (const [startX, startZ, endX, endZ] of open) {
      const acrossStart = Math.abs((startX - x0) * tz - (startZ - z0) * tx);
      const acrossEnd = Math.abs((endX - x0) * tz - (endZ - z0) * tx);
      if (acrossStart > 0.01 || acrossEnd > 0.01) continue;
      const start = (startX - x0) * tx + (startZ - z0) * tz;
      const end = (endX - x0) * tx + (endZ - z0) * tz;
      exclusions.push([Math.max(Math.min(start, end), 0), Math.min(Math.max(start, end), length)]);
    }
    exclusions.sort(([a], [b]) => a - b);
    let previous = 0;
    for (const [from, to] of exclusions) {
      if (from > previous + 0.01) {
        edges.push([[x0 + tx * previous, z0 + tz * previous], [x0 + tx * from, z0 + tz * from]]);
      }
      previous = Math.max(previous, to);
    }
    if (previous < length - 0.01) edges.push([[x0 + tx * previous, z0 + tz * previous], [x1, z1]]);
  }
  return edges;
}

function addWall(world: CollisionWorld, path: readonly PointXZ[], bottom: number, top: number,
  { kind = 2, round = false, group = null }: { kind?: number; round?: boolean; group?: string | null } = {}) {
  world.addTriangles(extrudeWallPolyline(path, () => bottom, () => top), { kind, round, group });
}

function addRoundWall(world: CollisionWorld, x: number, z: number, radius: number, bottom: number, top: number,
  sides = 8) {
  const points: PointXZ[] = Array.from({ length: sides + 1 }, (_, index) => [
    x + Math.cos(index / sides * Math.PI * 2) * radius,
    z + Math.sin(index / sides * Math.PI * 2) * radius,
  ]);
  addWall(world, points, bottom, top, { round: true });
}

function installTerrainEdges(world: CollisionWorld) {
  // The kit samples the whole installed terrain at both ends of each guard,
  // including overlaps between raised floors and their neighbors.
  const heightAt = (x: number, z: number) => world.groundAt(x, z)?.y ?? 0;
  const guard = (path: WallPath) => world.addTriangles(extrudeWallPolyline(path,
    (x, z) => heightAt(x, z) - 1, (x, z) => heightAt(x, z) + 4), { kind: 4 });
  for (const [, x0, z0, x1, z1, y, open = [], solid, depth = 26] of FLOORS) {
    const polygon = rectangle(x0, z0, x1, z1);
    if (solid !== 'block') for (const path of guardSegments(polygon, open)) guard(path);
    if (solid) addWall(world, [...polygon, polygon[0]], y - depth - 1, y - 0.02);
  }
  for (const [, x0, z0, x1, z1, , , closeNear, closeFar] of STAIRS) {
    guard([[x0, z0], [x0, z1]]);
    guard([[x1, z0], [x1, z1]]);
    if (closeNear) guard([[x0, z0], [x1, z0]]);
    if (closeFar) guard([[x0, z1], [x1, z1]]);
  }
  for (const [, x0, z0, x1, z1, , , direction] of ROOFS) {
    const eave = direction === 'south' ? z1 : z0;
    guard([[x0, eave], [x1, eave]]);
    guard([[x0, z0], [x0, z1]]);
    if (x1 < 44) guard([[x1, z0], [x1, z1]]);
  }
}

function installPropWalls(world: CollisionWorld) {
  for (let z = -462; z >= -502; z -= 10) {
    addRoundWall(world, 18, z, 0.95, 58, 68, 10);
    addRoundWall(world, 42, z, 0.95, 58, 68, 10);
  }
  for (const [kind, x, y, z, size] of PROP_FOOTPRINTS) {
    switch (kind) {
      case 'round':
        addRoundWall(world, x, z, size, y - 1, y + 2.4);
        break;
      case 'torii':
        for (const side of [-4.4, 4.4]) addRoundWall(world, x + side * size, z, 0.5 * size, y - 1, y + 4);
        break;
      case 'fallen': {
        const cosine = Math.cos(size);
        const sine = Math.sin(size);
        const localPoint = (dx: number, dz: number): PointXZ =>
          [x + dx * cosine + dz * sine, z - dx * sine + dz * cosine];
        addWall(world, [localPoint(-2.8, -0.35), localPoint(2.8, -0.35), localPoint(2.8, 0.35),
          localPoint(-2.8, 0.35), localPoint(-2.8, -0.35)], y - 1, y + 0.7);
        break;
      }
    }
  }
  for (const [kind, center, base, start, end] of SUPPORTS) {
    if (kind === 'gantry-z' || kind === 'gantry-x') {
      for (const offset of [-3.9, 3.9]) for (const extent of [start, end]) {
        const across = center + offset;
        const [x, z]: PointXZ = kind === 'gantry-z' ? [across, extent] : [extent, across];
        addRoundWall(world, x, z, 0.36, base - 1, base + 9, 6);
      }
    } else {
      for (const side of [-1, 1]) {
        const across = center + side * (end / 2 + 0.35);
        const [x, z]: PointXZ = kind === 'lift-x' ? [across, start] : [start, across];
        addRoundWall(world, x, z, 0.36, base - 1, base + 7, 6);
      }
    }
  }
  for (const [x, z] of BELL_POSTS) addRoundWall(world, x, z, 0.2, -20, 120, 6);
}

/** Install the static collision from the published Chapter Four load phase. */
export function createChapterFourWorld(): ChapterFourWorld {
  const world = createCollisionWorld();
  for (const [, x0, z0, x1, z1, y] of FLOORS) installTop(world, rectangle(x0, z0, x1, z1), () => y, 'stone');
  for (const stair of STAIRS) installSlope(world, stair, 'stair');
  for (const roof of ROOFS) installSlope(world, roof, 'stone');
  installTerrainEdges(world);
  for (const [, a, b, y, height, camera] of ARCHITECTURE_WALLS) {
    addWall(world, [a, b], y - 1.5, y + height, { kind: camera ? 10 : 2 });
  }
  installPropWalls(world);
  for (const [group, a, b, bottom, top] of GATE_WALLS) addWall(world, [a, b], bottom, top, { group });
  for (const disc of DISCS) world.addDisc(...disc);
  return { id: 'ch4_temple', spawn: chapterFourSpawn, killY: -12, killDrop: 16, world };
}
