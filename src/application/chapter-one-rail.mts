const cameraX = monotoneCurve(CAMERA_KEYS, 1);
const cameraY = monotoneCurve(CAMERA_KEYS, 2);
const cameraZ = monotoneCurve(CAMERA_KEYS, 3);
const cameraYaw = monotoneCurve(CAMERA_KEYS, 4);
const cameraPitch = monotoneCurve(CAMERA_KEYS, 5);
const feetX = monotoneCurve(FEET_KEYS, 1);
const feetY = monotoneCurve(FEET_KEYS, 2);
const feetZ = monotoneCurve(FEET_KEYS, 3);

export const chapterOneRail: FollowCameraRail = {
  poseAt(seconds, out) {
    const frame = seconds * RAIL_FPS;
    out.x = cameraX(frame);
    out.y = cameraY(frame);
    out.z = cameraZ(frame);
    out.yaw = cameraYaw(frame);
    out.pitch = cameraPitch(frame);
  },
  feetAt(seconds, out) {
    const frame = seconds * RAIL_FPS;
    out.x = feetX(frame);
    out.y = feetY(frame);
    out.z = feetZ(frame);
  },
};

