import type { FollowCameraArea, FollowCameraRail } from '../rendering/follow-camera.mts';

const RAIL_FPS = 24;

type RailKey = readonly [frame: number, ...channels: number[]];

function monotoneCurve(keys: readonly RailKey[], channel: number) {
  const frames = keys.map(key => key[0]);
  const values = keys.map(key => key[channel]!);
  const last = frames.length - 1;
  const secants = frames.slice(1).map((frame, index) =>
    (values[index + 1]! - values[index]!) / (frame - frames[index]!));
  const tangents = [secants[0]!];
  for (let i = 1; i < last; i++) {
    const before = secants[i - 1]!;
    const after = secants[i]!;
    tangents.push(before * after <= 0 ? 0 : (before + after) / 2);
  }
  tangents.push(secants[last - 1]!);

  // Limit the tangent pair to keep monotone segments from overshooting.
  for (const [i, secant] of secants.entries()) {
    if (secant === 0) {
      tangents[i] = tangents[i + 1] = 0;
      continue;
    }
    const start = tangents[i]! / secant;
    const end = tangents[i + 1]! / secant;
    const lengthSquared = start * start + end * end;
    if (lengthSquared > 9) {
      const scale = 3 / Math.sqrt(lengthSquared);
      tangents[i] = scale * start * secant;
      tangents[i + 1] = scale * end * secant;
    }
  }

  return (frame: number) => {
    if (frame <= frames[0]!) return values[0]!;
    if (frame >= frames[last]!) return values[last]!;

    let lower = 0;
    let upper = last;
    while (upper - lower > 1) {
      const middle = Math.floor((lower + upper) / 2);
      if (frames[middle]! <= frame) lower = middle;
      else upper = middle;
    }

    const span = frames[upper]! - frames[lower]!;
    const t = (frame - frames[lower]!) / span;
    const squared = t * t;
    const cubed = squared * t;
    return (2 * cubed - 3 * squared + 1) * values[lower]! +
      (cubed - 2 * squared + t) * span * tangents[lower]! +
      (-2 * cubed + 3 * squared) * values[upper]! +
      (cubed - squared) * span * tangents[upper]!;
  };
}

